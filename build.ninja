py_ver = 14

rule run
  command = $cmd
  pool = console

#
# Format C and Python (in-place)
#
build format: run
  cmd = clang-format --verbose -i src/*.h src/amsgpack.c && $
    python3 -m black .;

shared_lib_path = amsgpack/_amsgpack.cpython-3${py_ver}-x86_64-linux-gnu.so

#
# Build library
#

cc = gcc

rule build_lib
  depfile = $out.d
  deps = gcc
  command = $
    $cc $cflags -fPIC -shared `python3.${py_ver}-config --includes` $
      $in $
      -MD -MF $out.d $
      `python3.${py_ver}-config --ldflags` $
      -o $out
  pool = console


#
# Test
#

build unittest: phony $
  test/test/test_amsgpack.py $
  test/test/test_ext.py $
  test/test/test_file_unpacker.py $
  test/test/test_pack.py $
  test/test/test_suite.py $
  test/test/test_timestamp.py $
  test/test/test_typing.py $
  test/test/test_unpack.py $
  test/sitecustomize.py

build build/test/$shared_lib_path: build_lib src/amsgpack.c
  cflags = -O0 -g

rule test
  command = $
    cd test && $
    PYTHONPATH=.:../build/test $
      python -m unittest
  pool = console
build unittest_test: test build/test/$shared_lib_path | unittest
build test: phony unittest_test

#
# Coverage
#

build build/coverage/$shared_lib_path: build_lib src/amsgpack.c
  cflags = --coverage -O0

rule coverage_gcno
  command = $
    cd test && $
    PYTHONPATH=.:../build/coverage $
      python -m unittest
  pool = console

rule coverage_report
  command = $
    cd build/coverage && $
    gcovr $
      --object-directory amsgpack $
      --root ../.. $
      --html-details -o coverage_report.html && $
    echo 'opening in a web browser coverage_report.html' && $
    python -m webbrowser coverage_report.html
  pool = console

gcno_path = build/coverage/${shared_lib_path}-amsgpack.gcno
build $gcno_path : coverage_gcno $
  build/coverage/$shared_lib_path | unittest

build build/coverage/coverage_report.html: coverage_report $
  $gcno_path | unittest
build coverage: phony build/coverage/coverage_report.html

#
# Fuzzer
#

build build/fuzzer/$shared_lib_path: build_lib src/amsgpack.c
  cflags = -g

rule build_fuzzer
  depfile = $out.d
  deps = gcc
  description = generate fuzzer executable with clang
  command = $
    clang -DAMSGPACK_FUZZER=1 $
        -g3 -O0 $
        -fsanitize=fuzzer $
        -fsanitize=address $
        -fsanitize=undefined $
        -fPIE $
        $$(python3.${py_ver}-config --includes) $
        $in $$(python3.${py_ver}-config --ldflags --embed) $
         -MD -MF $out.d $
        -o $out
build build/fuzzer/amsgpack_fuzzer : build_fuzzer src/amsgpack.c

build fuzzer: run | build/fuzzer/amsgpack_fuzzer
  cmd = $
    mkdir -p build/fuzzer/corpus && $
    cd build/fuzzer && $
    ASAN_OPTIONS=symbolize=1:print_stacktrace=1,detect_leaks=1,log_path=amsgpack_leak.log $
    PYTHONPATH=. $
      ./amsgpack_fuzzer corpus

#
# valgrind
#

build build/valgrind/$shared_lib_path: build_lib src/amsgpack.c
  cflags = -g
build valgrind: run | build/valgrind/$shared_lib_path unittest
  cmd = $
    cd test && $
    PYTHONMALLOC=malloc PYTHONPATH=.:../build/valgrind $
      valgrind $
        --leak-check=full $
        --show-leak-kinds=definite $
        --track-origins=yes $
      python -m unittest -v
  pool = console

#
# help
#
build show_help: run
  cmd = echo -e $
    '\n'$
    'This script is for developers only.\n'$
    'To install the package, use `python -m pip install -e . --no-build-isolation`\n'$
    '\nUse `ninja -t targets` to see all the targets'

# Make all targets available
default show_help
